{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // O Node (npm test) só acha o módulo com a extensão: "./painel.ts".
    "allowImportingTsExtensions": true,
    // Ícones importados um a um: os tipos vêm do build da lib, não do código-fonte dela.
    "paths": {
      "phosphor-react-native/src/icons/*": [
        "./node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  // Os testes rodam no Node (npm test), fora do bundle do app.
  "exclude": ["node_modules", "src/**/*.test.ts", "e2e", "playwright.config.ts"]
}
