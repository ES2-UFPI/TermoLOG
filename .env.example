DATABASE_USERNAME=termolog
DATABASE_PASSWORD=termolog
DATABASE_NAME=termolog
# Nome que sai no cabeçalho dos relatórios (GET /relatorios/leituras).
ESTABELECIMENTO_NOME=
# IPs do proxy reverso (Nginx, Traefik...) na frente da API, separados por vírgula.
# Sem proxy, deixe vazio. Ver "Limite de tentativas de login e proxy" no README.
FORWARDED_ALLOW_IPS=

# Alertas por e-mail. No desenvolvimento, o docker-compose.override.yml já aponta para
# o Mailpit (http://localhost:8025) e estas variáveis podem ficar de fora. Em produção,
# informe o servidor SMTP de verdade.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USUARIO=termolog
# SMTP_SENHA=
# SMTP_REMETENTE=alertas@exemplo.com
# SMTP_STARTTLS=true

# Alertas pelo Telegram: token do bot (criado no @BotFather) e nome do bot sem o @.
# TELEGRAM_POLLING=false desliga a busca das mensagens do vínculo (ex.: réplica da API).
# Ver "Alertas pelo Telegram" no README.
# Use o SEU próprio bot no .env local: o Telegram entrega as mensagens a um consumidor só,
# então o mesmo token em dois ambientes faz um roubar as mensagens do outro. O .env não
# vai para o git: nunca coloque o token em commit, issue ou PR (se vazar, /revoke no BotFather).
# Cole o token do BotFather no lugar do exemplo (formato <números>:<letras e números>).
# TELEGRAM_BOT_TOKEN=123456789:COLE_AQUI_O_TOKEN_DO_BOTFATHER
# O nome do bot é opcional: a API o descobre pelo token. Só preencha para forçar um nome.
# Depois de criar o bot, rode `python -m notificacoes.configurar_bot` (ver o README).
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_POLLING=true
